# SECURITY: Keep .env.local out of Git. Never use production credentials for a demo.
# Default behavior is DEMO. Live calls require ALL of:
# 1) ENABLE_LIVE_INTEGRATIONS=true
# 2) a strong INTEGRATION_LAB_ADMIN_TOKEN supplied in the dashboard
# 3) the relevant provider credentials below
ENABLE_LIVE_INTEGRATIONS=false
INTEGRATION_LAB_ADMIN_TOKEN=

# Meta WhatsApp Cloud API (use a TEST sender / verified test recipient)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_TEMPLATE_NAME=hello_world
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Mailgun (sandbox domain supports authorized recipients only)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=
MAILGUN_REGION=us

# AWS S3 (private bucket; use a least-privilege dedicated IAM identity)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
S3_BUCKET=
S3_PREFIX=integration-lab/
# Optional S3-compatible local emulator (e.g. Moto)
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
